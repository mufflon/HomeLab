# Copy to .env (gitignored) and fill in. Never commit .env.
# scripts/secrets.sh turns these into Kubernetes Secrets.

# Let's Encrypt via lego (k8s/ingress)
ACME_EMAIL=                 # Let's Encrypt account email (kept out of the public repo)
LOOPIA_API_USER=            # LoopiaAPI user: getZoneRecords, addZoneRecord, removeZoneRecord, removeSubdomain only
LOOPIA_API_PASSWORD=

# Zotero WebDAV (k8s/research/zotero-webdav): the one WebDAV user
ZOTERO_WEBDAV_USER=
ZOTERO_WEBDAV_PASSWORD=     # long and random (letters/digits); also typed into Zotero's sync settings

# Karakeep (k8s/research/karakeep)
KARAKEEP_NEXTAUTH_SECRET=   # openssl rand -base64 36
MEILI_MASTER_KEY=           # openssl rand -base64 36
KARAKEEP_API_KEY=           # for paperbridge: Karakeep -> Settings -> API Keys, after first login (build step 4)
OPENAI_API_KEY=             # optional: Karakeep AI tagging

# paperbridge (k8s/research/paperbridge); it also uses KARAKEEP_API_KEY and the WebDAV login above
ZOTERO_USER_ID=             # zotero.org -> Settings -> Security: "Your user ID for use in API calls"
ZOTERO_API_KEY=             # zotero.org -> Settings -> Security -> new private key: library access + write, no groups
UNPAYWALL_EMAIL=            # optional: your email, which Unpaywall requires, to find open-access PDFs by DOI

# Alerts (k8s/monitoring, host/02-alerts.sh): healthchecks.io does the alerting
HEALTHCHECKS_API_KEY=       # healthchecks.io -> project -> Settings -> API Access: the read-write key, not the read-only one
