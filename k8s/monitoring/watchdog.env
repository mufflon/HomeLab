# Endpoints: "name method url expected-status", separated by ";". {HOST_IP} is the node's address
# (Jellyfin runs on the host, outside the cluster). WebDAV must refuse an anonymous request.
ENDPOINTS=Karakeep GET https://karakeep.home.threadsafe.se/api/health 200; WebDAV GET https://zotero-dav.home.threadsafe.se/ 401; Jellyfin GET http://{HOST_IP}:8096/health 200
# Any name works: every service gets the same wildcard certificate.
CERT_HOST=karakeep.home.threadsafe.se
# Fail with less than this fraction of the certificate's lifetime left: 18 days of a 90-day one.
CERT_MIN_FRACTION=0.2
# Pools that must be imported; every imported pool must be ONLINE.
POOLS=hddpool
# Workloads and endpoints that fail are checked once more after this long.
RETRY_SECONDS=60
